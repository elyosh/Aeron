{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AERON_flight_model node extension",
  "oneOf": [
    { "$ref": "#/$defs/model" },
    { "$ref": "#/$defs/component" },
    { "$ref": "#/$defs/hardpoint" },
    { "$ref": "#/$defs/engineGlow" },
    { "$ref": "#/$defs/collision" },
    { "$ref": "#/$defs/light" }
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "extent3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 4,
      "maxItems": 4
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "simulationData": {
      "type": "object",
      "required": ["version", "bufferView", "topologyHash"],
      "properties": {
        "version": { "const": 1 },
        "bufferView": { "type": "integer", "minimum": 0 },
        "topologyHash": { "$ref": "#/$defs/hash" }
      }
    },
    "renderData": {
      "type": "object",
      "required": ["version", "bufferView", "meshHash"],
      "properties": {
        "version": { "const": 1 },
        "bufferView": { "type": "integer", "minimum": 0 },
        "meshHash": { "$ref": "#/$defs/hash" }
      }
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9._]{1,63}$"
    },
    "articulation": {
      "type": "object",
      "required": ["component", "group", "angle", "speed"],
      "properties": {
        "component": { "type": "integer", "minimum": 0, "maximum": 254 },
        "group": { "$ref": "#/$defs/tag" },
        "angle": { "type": "integer", "minimum": -128, "maximum": 255 },
        "speed": { "type": "integer", "minimum": 0, "maximum": 255 },
        "speedBack": { "type": "integer", "minimum": 0, "maximum": 255 },
        "behavior": { "$ref": "#/$defs/tag" }
      }
    },
    "model": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "const": "model" },
        "renderData": { "$ref": "#/$defs/renderData" },
        "articulations": { "type": "array", "items": { "$ref": "#/$defs/articulation" } },
        "componentSets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tag" },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 254 }
          }
        },
        "articulationSettings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tag" },
          "additionalProperties": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
        }
      }
    },
    "rotation": {
      "type": "object",
      "required": ["pivot", "rotationAxis", "directionAxis", "upAxis"],
      "properties": {
        "pivot": { "$ref": "#/$defs/vec3" },
        "rotationAxis": { "$ref": "#/$defs/vec3" },
        "directionAxis": { "$ref": "#/$defs/vec3" },
        "upAxis": { "$ref": "#/$defs/vec3" }
      }
    },
    "component": {
      "type": "object",
      "required": ["role", "meshType"],
      "properties": {
        "role": { "const": "component" },
        "meshType": { "type": "integer", "minimum": 0, "maximum": 31 },
        "explosionFlags": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "targetId": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "target": { "$ref": "#/$defs/vec3" },
        "span": { "$ref": "#/$defs/extent3" },
        "center": { "$ref": "#/$defs/vec3" },
        "boundsMin": { "$ref": "#/$defs/vec3" },
        "boundsMax": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/rotation" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "simulationData": { "$ref": "#/$defs/simulationData" }
      },
      "allOf": [
        {
          "if": {
            "required": ["targetId"],
            "properties": { "targetId": { "not": { "const": 0 } } }
          },
          "then": { "required": ["target"] }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["span"] },
              { "required": ["center"] },
              { "required": ["boundsMin"] },
              { "required": ["boundsMax"] }
            ]
          },
          "then": { "required": ["span", "center", "boundsMin", "boundsMax"] }
        }
      ]
    },
    "hardpoint": {
      "type": "object",
      "required": ["role", "type"],
      "properties": {
        "role": { "const": "hardpoint" },
        "type": { "type": "integer", "minimum": 0, "maximum": 39 }
      }
    },
    "collision": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "collision" } }
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "light": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "const": "light" },
        "shape": { "enum": ["point", "tube", "panel"], "default": "point" },
        "length": { "$ref": "#/$defs/positive" },
        "size": {
          "type": "array",
          "items": { "$ref": "#/$defs/positive" },
          "minItems": 2,
          "maxItems": 2
        },
        "oneSided": { "type": "boolean" },
        "radius": { "$ref": "#/$defs/positive" }
      },
      "allOf": [
        {
          "if": { "properties": { "shape": { "const": "tube" } }, "required": ["shape"] },
          "then": {
            "required": ["length"],
            "not": { "required": ["size"] }
          }
        },
        {
          "if": { "properties": { "shape": { "const": "panel" } }, "required": ["shape"] },
          "then": {
            "required": ["size"],
            "properties": { "oneSided": { "const": true } },
            "allOf": [
              { "not": { "required": ["length"] } },
              { "not": { "required": ["radius"] } }
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              { "not": { "required": ["shape"] } },
              { "properties": { "shape": { "const": "point" } } }
            ]
          },
          "then": {
            "allOf": [
              { "not": { "required": ["length"] } },
              { "not": { "required": ["size"] } },
              { "not": { "required": ["oneSided"] } }
            ]
          }
        }
      ]
    },
    "engineGlow": {
      "type": "object",
      "required": ["role", "coreColor", "outerColor"],
      "properties": {
        "role": { "const": "engineGlow" },
        "enabled": { "type": "boolean", "default": true },
        "coreColor": { "$ref": "#/$defs/color" },
        "outerColor": { "$ref": "#/$defs/color" }
      }
    }
  }
}
