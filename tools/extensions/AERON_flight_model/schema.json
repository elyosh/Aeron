{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AERON_flight_model node extension",
  "oneOf": [
    { "$ref": "#/$defs/model" },
    { "$ref": "#/$defs/component" },
    { "$ref": "#/$defs/hardpoint" },
    { "$ref": "#/$defs/engineGlow" },
    { "$ref": "#/$defs/collision" }
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "extent3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 4,
      "maxItems": 4
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "simulationData": {
      "type": "object",
      "required": ["version", "bufferView", "topologyHash"],
      "properties": {
        "version": { "const": 1 },
        "bufferView": { "type": "integer", "minimum": 0 },
        "topologyHash": { "$ref": "#/$defs/hash" }
      }
    },
    "renderData": {
      "type": "object",
      "required": ["version", "bufferView", "meshHash"],
      "properties": {
        "version": { "const": 1 },
        "bufferView": { "type": "integer", "minimum": 0 },
        "meshHash": { "$ref": "#/$defs/hash" }
      }
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9._]{1,63}$"
    },
    "model": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "const": "model" },
        "renderData": { "$ref": "#/$defs/renderData" }
      }
    },
    "rotation": {
      "type": "object",
      "required": ["pivot", "rotationAxis", "directionAxis", "upAxis"],
      "properties": {
        "pivot": { "$ref": "#/$defs/vec3" },
        "rotationAxis": { "$ref": "#/$defs/vec3" },
        "directionAxis": { "$ref": "#/$defs/vec3" },
        "upAxis": { "$ref": "#/$defs/vec3" }
      }
    },
    "component": {
      "type": "object",
      "required": ["role", "meshType"],
      "properties": {
        "role": { "const": "component" },
        "meshType": { "type": "integer", "minimum": 0, "maximum": 31 },
        "explosionFlags": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "targetId": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "target": { "$ref": "#/$defs/vec3" },
        "span": { "$ref": "#/$defs/extent3" },
        "center": { "$ref": "#/$defs/vec3" },
        "boundsMin": { "$ref": "#/$defs/vec3" },
        "boundsMax": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/rotation" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "simulationData": { "$ref": "#/$defs/simulationData" }
      },
      "allOf": [
        {
          "if": {
            "required": ["targetId"],
            "properties": { "targetId": { "not": { "const": 0 } } }
          },
          "then": { "required": ["target"] }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["span"] },
              { "required": ["center"] },
              { "required": ["boundsMin"] },
              { "required": ["boundsMax"] }
            ]
          },
          "then": { "required": ["span", "center", "boundsMin", "boundsMax"] }
        }
      ]
    },
    "hardpoint": {
      "type": "object",
      "required": ["role", "type"],
      "properties": {
        "role": { "const": "hardpoint" },
        "type": { "type": "integer", "minimum": 0, "maximum": 39 }
      }
    },
    "collision": {
      "type": "object",
      "required": ["role"],
      "properties": { "role": { "const": "collision" } }
    },
    "engineGlow": {
      "type": "object",
      "required": ["role", "coreColor", "outerColor"],
      "properties": {
        "role": { "const": "engineGlow" },
        "enabled": { "type": "boolean", "default": true },
        "coreColor": { "$ref": "#/$defs/color" },
        "outerColor": { "$ref": "#/$defs/color" }
      }
    }
  }
}
